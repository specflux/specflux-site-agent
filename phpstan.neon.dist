parameters:
    level: 8
    paths:
        - src
        - senroflux.php
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanFiles:
        # WordPress core symbols referenced from src (declarations only).
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

    # Justified, scoped suppressions for known wordpress-stubs false positives
    # (stub-signature limitations, not defects). Each entry is pinned to an
    # exact message so a NEW violation fails loudly instead of being absorbed.
    ignoreErrors:
        -
            # WooCommerce is not installed in this checkout, so phpstan cannot
            # resolve its shipping classes; addZoneMethod() is only reached
            # from executeShippingZoneSave(), behind its class_exists() guard.
            message: '#^(Parameter \$zone of method .*addZoneMethod\(\) has invalid type WC_Shipping_Zone\.|Call to .* on an unknown class WC_Shipping_Zones?\.|Class WC_Shipping_Method not found\.|(Call to method|Access to property) .* on an unknown class WC_Shipping_Method\.)$#'
            path: src/Packs/Commerce/Abilities.php
            count: 8
        -
            # WooCommerce is not installed in this checkout, so the product
            # objects wc_get_product() hands the C4-W polyfills (stock-adjust,
            # variation-price-update, sale-schedule) are untyped `object`s. Every
            # call is on the WC_Product CRUD surface and is reached only after
            # wcProduct() has returned a real product object.
            message: '#^Call to an undefined method object::(get_manage_stock|set_stock_status|save|get_stock_quantity|get_stock_status|is_type|get_parent_id|get_id|get_regular_price|get_sale_price|set_regular_price|set_sale_price|set_date_on_sale_from|set_date_on_sale_to)\(\)\.$#'
            path: src/Packs/Commerce/Abilities.php
            count: 27
        -
            # wpdb::prepare()'s stub requires `@phpstan-param literal-string
            # $query`, but every prepared statement interpolates this plugin's
            # OWN computed table names into an otherwise-literal SQL template
            # — never request/user input.
            message: '#^Parameter \#1 \$query of method wpdb::prepare\(\) expects literal\-string, non\-falsy\-string given\.$#'
            path: src/*
            count: 7
        -
            # Same family: prepare() returns string|void per the stub, which
            # collides with query()'s non-nullable string parameter.
            message: '#^Parameter \#1 \$query of method wpdb::query\(\) expects string, string\|null given\.$#'
            path: src/*
            count: 1
        -
            # Message::fromArray() documents a narrow PHPStan array-shape
            # generic; Step stores exactly toArray() output (S4), so the shape
            # holds BY CONSTRUCTION and the SDK's generic cannot see it.
            message: '#^Parameter \#1 \$array of static method WordPress\\AiClient\\Messages\\DTO\\Message::fromArray\(\) expects array\{role: string, parts: array.*given\.$#'
            path: src/Run/Step.php
            count: 1
        -
            # Defensive runtime checks against wp_get_ability()'s real-world
            # null/object outcomes. wordpress-stubs types the return as
            # non-nullable WP_Ability, so these two checks look constant to
            # PHPStan — they are not, across real WordPress versions and the
            # test shim.
            message: '#^Call to function is_object\(\) with WP_Ability will always evaluate to true\.$#'
            path: src/Tools/ToolExecutor.php
            count: 1
        -
            # Schema::ensureUpgrade()'s require_once is a real-WordPress-only
            # fallback (dbDelta() always exists mid-request in core) for a
            # genuine WP-core file that never exists in this checkout.
            message: '#^Path in require_once\(\) ".*wp\-admin/includes/upgrade\.php" is not a file or it does not exist\.$#'
            path: src/Schema.php
            count: 1
        -
            # Same family: Onboarding::pluginState() loads get_plugins() from
            # the real WP-core file only when it hasn't already been loaded
            # mid-request — never present in this checkout.
            message: '#^Path in require_once\(\) ".*wp\-admin/includes/plugin\.php" is not a file or it does not exist\.$#'
            path: src/Setup/Onboarding.php
            count: 1
        -
            # Same family: AiClientMediaGateway's download_url()/wp_upload_bits()
            # fallback requires the real WP-core file only when it hasn't
            # already been loaded mid-request — never present in this checkout.
            message: '#^Path in require_once\(\) ".*wp\-admin/includes/file\.php" is not a file or it does not exist\.$#'
            path: src/Model/AiClientMediaGateway.php
            count: 2
        -
            # Same family: OpenverseStockImageGateway's download_url()/
            # wp_upload_bits() fallback requires the real WP-core file only
            # when it hasn't already been loaded mid-request — never present
            # in this checkout.
            message: '#^Path in require_once\(\) ".*wp\-admin/includes/file\.php" is not a file or it does not exist\.$#'
            path: src/Model/OpenverseStockImageGateway.php
            count: 2
        -
            # Message::fromArray() documents a narrow PHPStan array-shape
            # generic; Runner stores exactly toArray() output (S4), so the
            # shape holds BY CONSTRUCTION (same as Step::toMessage()).
            # Three call sites: unconsumedCalls(), unansweredCallId() (the one
            # recovery path both harness parks share) and historyForPrompt(),
            # which only removes parts or shortens strings inside them.
            message: '#^Parameter \#1 \$array of static method WordPress\\AiClient\\Messages\\DTO\\Message::fromArray\(\) expects array\{role: string, parts: array.*given\.$#'
            path: src/Run/*
            count: 3
        -
            # SenroGate's `changes()` API object (0.5) is not installed in this
            # checkout and is only reached behind the method_exists() probes in
            # ChangesBridge::api(), so phpstan sees a bare `object`.
            message: '#^Call to an undefined method object::(forCorrelation|preview|undo)\(\)\.$#'
            path: src/Approval/ChangesBridge.php
            count: 4
        -
            # The Agent Safety go-forward pack lives in the external
            # wp-agentsafety plugin, which is NOT installed in this checkout;
            # phpstan therefore cannot resolve these classes. Every code path
            # that touches them is already behind a `class_exists()` guard
            # (agentSafetyBindingError() / agentSafetyPack()).
            message: '#^Method Specflux\\SenroFlux\\Packs\\Pages\\PagesPack::resolveAsPackForUser\(\) has invalid return type Specflux\\AgentSafety\\Packs\\Pack\.$#'
            path: src/Packs/Pages/PagesPack.php
            count: 2
        -
            # Same external-class situation: PackResolver is only reached after
            # the class_exists() guard in agentSafetyBindingError().
            message: '#^Instantiated class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver not found\.$#'
            path: src/Packs/Pages/PagesPack.php
            count: 1
        -
            # registry() is a method on the external PackResolver, reached only
            # behind the same class_exists() guard.
            message: '#^Call to method registry\(\) on an unknown class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver\.$#'
            path: src/Packs/Pages/PagesPack.php
            count: 1
        -
            # Same external-class situation as PagesPack's binding check
            # (S5's posts pack duplicates the same S13 pattern).
            message: '#^Method Specflux\\SenroFlux\\Packs\\Posts\\PostsPack::resolveAsPackForUser\(\) has invalid return type Specflux\\AgentSafety\\Packs\\Pack\.$#'
            path: src/Packs/Posts/PostsPack.php
            count: 2
        -
            message: '#^Instantiated class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver not found\.$#'
            path: src/Packs/Posts/PostsPack.php
            count: 1
        -
            message: '#^Call to method registry\(\) on an unknown class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver\.$#'
            path: src/Packs/Posts/PostsPack.php
            count: 1
        -
            # Same external-class situation as PagesPack's/PostsPack's binding
            # check (S7's site pack duplicates the same S13 pattern).
            message: '#^Method Specflux\\SenroFlux\\Packs\\Site\\SitePack::resolveAsPackForUser\(\) has invalid return type Specflux\\AgentSafety\\Packs\\Pack\.$#'
            path: src/Packs/Site/SitePack.php
            count: 2
        -
            message: '#^Instantiated class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver not found\.$#'
            path: src/Packs/Site/SitePack.php
            count: 1
        -
            message: '#^Call to method registry\(\) on an unknown class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver\.$#'
            path: src/Packs/Site/SitePack.php
            count: 1
        -
            # Same external-class situation as the other packs' binding check
            # (S19's commerce pack duplicates the same S13 pattern).
            message: '#^Method Specflux\\SenroFlux\\Packs\\Commerce\\CommercePack::resolveAsPackForUser\(\) has invalid return type Specflux\\AgentSafety\\Packs\\Pack\.$#'
            path: src/Packs/Commerce/CommercePack.php
            count: 2
        -
            message: '#^Instantiated class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver not found\.$#'
            path: src/Packs/Commerce/CommercePack.php
            count: 1
        -
            message: '#^Call to method registry\(\) on an unknown class Specflux\\AgentSafety\\Plugin\\Support\\PackResolver\.$#'
            path: src/Packs/Commerce/CommercePack.php
            count: 1
